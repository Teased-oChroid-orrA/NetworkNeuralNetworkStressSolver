# pinn.env — PINN Structural Stress Solver configuration
# Edit this file and restart the solver to apply changes.
# Restart = re-run the binary (headless or GUI); no recompile required.
#
# Units: stress/modulus in US Customary (ksi / Msi); length in inches.
# SI conversion is applied automatically on startup.
#
# Booleans accept: true / false  (case-insensitive; 1/0/yes/no also accepted)
# Numeric values accept standard decimal and scientific notation (e.g. 1e-3).
# Lines starting with '#' and blank lines are ignored.
# Unknown keys are silently ignored.

# ── Sampling & training schedule ──────────────────────────────────────────────
N_INTERIOR=4096       # interior collocation points (Phase 1 floor; AMR grows from here)
N_BOUNDARY=1024       # boundary collocation points
MAX_STEPS=28000       # total training steps (Phase 1 + Phase 2)
VIS_GRID_NX=64        # heatmap grid columns
VIS_GRID_NY=64        # heatmap grid rows

# ── Network architecture ───────────────────────────────────────────────────────
HIDDEN_DIM=128        # neurons per hidden layer
N_HIDDEN=5            # number of hidden layers
FD_H=1e-3             # finite-difference step in normalized [-1,1]^2 coordinates

# ── Optimizer ─────────────────────────────────────────────────────────────────
USE_SOAP_MUON=true    # true = SOAP-Muon hybrid for weight matrices; false = AdamW-only
USE_PIRATENET=true   # opt-in adaptive-residual gates on layers[1..] (identity at init;
                      # see stiffness section below). false = plain MLP, unchanged behavior.

# ── Meta-optimizer decision maker ─────────────────────────────────────────────
# Opt-in three-tier optimizer state machine (Explore/Align/Converge).
# Requires USE_SOAP_MUON=true for the SOAP-Muon (Align) tier.
# All tier transitions are driven by gradient conflict metrics — K_t is NEVER
# used as a gate (it is a post-hoc verification metric only).
DM_ENABLED=true              # false = disabled; existing behavior unchanged
DM_CHECK_INTERVAL=50          # steps between gradient conflict evaluations
DM_CONFLICT_THRESHOLD=0.60    # cosine < threshold triggers Explore → Align
DM_ALIGNMENT_THRESHOLD=0.25   # cosine > threshold triggers Align → Explore (hysteresis)
DM_CONVERGE_COSINE_MIN=0.75   # minimum cosine similarity required to enter Converge
DM_CONVERGE_GRAD_THRESHOLD=5.0  # g_total_norm threshold for Converge entry (dimensionless)
DM_USE_EXACT_COSINE=true      # true = dual-pass cosine; false = cheap proxy (no Converge tier)
DM_MIN_DWELL_STEPS=50         # minimum steps in any tier before a transition is allowed
DM_LBFGS_MAX_ITER=5           # L-BFGS max inner iterations per outer step (Converge tier)

# ── Stiffness-coupled SAW-BRDR / PirateNet-gate accelerator ───────────────────
# Opt-in. Reuses the same gradient-conflict cosine-similarity metric as the decision
# maker above (independent subsystem — works with either, both, or neither enabled).
# Boosts SAW-BRDR's physics-loss weight and accelerates PirateNet gate learning rate
# when physics/BC gradients conflict. K_t is NEVER read here either.
STIFF_ENABLED=false            # false = disabled; step_physics receives boost=1.0, mult=1.0
STIFF_CHECK_INTERVAL=50        # steps between gradient conflict evaluations
STIFF_EMA_BETA=0.7             # EMA smoothing factor for the held stiffness value
STIFF_PHYSICS_BOOST_GAIN=1.0   # SAW physics-loss boost gain; hard-clamped to [1,4] regardless
STIFF_ALPHA_ACCEL_GAIN=2.0     # PirateNet gate-LR multiplier gain; hard-clamped to [1,5]
STIFF_GATE_AWAKE_EPSILON=1e-4  # |gate| above this = awake, included in SOAP-Muon weight set

# ── Execution / performance profile ───────────────────────────────────────────
# Hardware-adaptive-execution epic, Phase 1: both keys are accepted, validated, and
# threaded through SolverConfig, but do NOT yet change any executed code path — nothing
# reads them to alter behavior until a later phase's profiling work justifies what each
# value should concretely do (see pinn_solver::execution's module doc).
EXEC_MODE=auto          # auto | serial  (Phase 1: both behave identically — serial)
EXEC_PROFILE=balanced   # eco | balanced | performance | maximum  (Phase 1: no behavioral effect)

# ── Diagnostics ────────────────────────────────────────────────────────────────
# Hardware-adaptive-execution epic, Phase 2. Real, opt-in per-step wall-time
# instrumentation (forward+loss-assembly / backward / optimizer, in StepOutput.timing).
# Adds a real device-sync cost when enabled — off by default. See
# pinn_solver::diagnostics's module doc for why a sync is unavoidable for honest numbers.
DIAGNOSTICS_ENABLED=false

# ── Material ──────────────────────────────────────────────────────────────────
MATERIAL_E_MSI=10.4   # Young's modulus [Msi]  — Al 7075-T6 default (≈71.7 GPa)
MATERIAL_NU=0.33      # Poisson's ratio [dimensionless]

# ── Loading: far-field traction boundary conditions ───────────────────────────
# Px / Py are far-field *stress* (traction BCs), not forces — units ksi like any stress.
LOAD_PX_KSI=10.0     # far-field stress in x-direction [ksi]
LOAD_PY_KSI=0.0      # far-field stress in y-direction [ksi]  (0 = uniaxial tension)

# ── Geometry ──────────────────────────────────────────────────────────────────
GEOM_HALF_W_IN=5.0    # plate half-width  [in]  — full width  = 2 × GEOM_HALF_W_IN
GEOM_HALF_H_IN=5.0    # plate half-height [in]  — full height = 2 × GEOM_HALF_H_IN
HOLE_RADIUS_IN=0.125  # circular hole radius [in]  — diameter = 2 × HOLE_RADIUS_IN
